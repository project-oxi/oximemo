{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oxinot",
  "version": "0.4.0",
  "identifier": "com.oxinot.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "capture",
        "title": "Capture",
        "width": 560,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "x": -9999,
        "y": -9999
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: oximg:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "publisher": "oxinot",
    "category": "Productivity",
    "copyright": "© 2026 oxinot",
    "shortDescription": "Capture a thought before it's gone.",
    "longDescription": "A fast, minimal, card-based memo app for macOS (Apple Silicon).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist"
    }
  }
}
