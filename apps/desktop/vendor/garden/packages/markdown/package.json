{
  "name": "@garden/markdown",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Portable Document Contract 2 Markdown and query parsing primitives for garden.",
  "exports": {
    "./syntax": {
      "types": "./src/syntax.ts",
      "import": "./src/syntax.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./storage": {
      "types": "./src/storage.ts",
      "import": "./src/storage.ts"
    }
  },
  "files": ["src", "README.md", "LICENSE.atomic-editor"],
  "scripts": {
    "build": "bun scripts/embed-envelope-schema.mjs && tsc -p tsconfig.json",
    "test": "bun scripts/embed-envelope-schema.mjs --check && bun test"
  },
  "dependencies": {
    "@lezer/highlight": "1.2.3",
    "@lezer/markdown": "1.7.2",
    "yaml": "2.8.1"
  }
}
