{
  "format": "pdc-document-render-policy/3",
  "common": {
    "allowedSchemes": ["http", "https", "mailto", "pdc"],
    "internallyResolvedSchemes": ["pdc"],
    "blockedSchemes": ["data", "file", "javascript", "vbscript"],
    "externalResourcesDuringIndexing": false,
    "externalSubresources": "policy-gated",
    "relativeVaultLinks": {
      "canonical": true,
      "mustStayInVault": true,
      "followSymlinks": false
    }
  },
  "profiles": {
    "pdc-markdown/1": {
      "profileStatus": "canonical",
      "renderMode": "sanitize-generated-html",
      "allowedElements": [
        "a", "blockquote", "br", "caption", "code", "del", "div", "em",
        "figcaption", "figure", "h1", "h2", "h3", "h4", "h5", "h6",
        "hr", "img", "input", "ins", "li", "mark", "ol", "p", "pre",
        "section", "span", "strong", "sub", "sup", "table", "tbody",
        "td", "tfoot", "th", "thead", "tr", "ul"
      ],
      "allowedAttributes": {
        "*": ["aria-*", "class", "id", "lang", "role", "title", "data-pdc-*", "data-x-*-*"],
        "a": ["href"],
        "img": ["alt", "height", "src", "width"],
        "input": ["checked", "disabled", "type"],
        "ol": ["start", "type"],
        "td": ["colspan", "rowspan"],
        "th": ["colspan", "rowspan", "scope"]
      },
      "attributeConstraints": {
        "input": { "type": "checkbox", "disabled": true }
      },
      "blockedAttributes": ["style", "srcdoc", "on*"],
      "blockedElements": [
        "applet", "audio", "base", "button", "embed", "form", "iframe",
        "input[type!=checkbox]", "link", "meta", "object", "script",
        "select", "source", "style", "textarea", "track", "video"
      ],
      "unknownElementAction": "unwrap-preserving-children",
      "blockedElementAction": "remove-entire-subtree",
      "compatibilitySyntaxFallbacks": {
        "wikiLink": "render-as-link-or-text",
        "wikiEmbed": "render-as-link-fallback",
        "callout": "render-as-blockquote",
        "highlight": "render-as-mark",
        "sourceComment": "hide-with-readable-fallback",
        "math": "render-as-text-or-span",
        "footnote": "render-as-section-notes",
        "inlineTag": "render-as-link-or-text",
        "caretBlockId": "preserve-as-target-anchor"
      },
      "rawHtml": {
        "preserveSource": true,
        "renderMode": "sanitize",
        "activeConstructsDiagnostic": "unsafe_content"
      }
    },
    "pdc-html/1": {
      "profileStatus": "canonical",
      "renderMode": "sanitize-source-into-isolated-view",
      "preserveSource": true,
      "allowInlineStyleInIsolation": true,
      "blockedElements": [
        "applet", "base", "embed", "form", "iframe", "object", "script"
      ],
      "blockedAttributes": ["formaction", "srcdoc", "on*"],
      "metaRefresh": "blocked",
      "nestedBrowsingContexts": "blocked",
      "forms": "inert",
      "popups": "blocked",
      "topNavigation": "blocked",
      "scripts": "blocked",
      "cssImports": "policy-gated",
      "cssExternalUrls": "policy-gated",
      "externalStylesheets": "policy-gated",
      "externalFonts": "policy-gated",
      "unknownElementAction": "preserve-source-unwrap-render",
      "sanitizedRenderMustNotMutateSource": true
    },
    "pdc-djot/1": {
      "profileStatus": "legacy-v1",
      "legacyForFormat": ["pdc-document/1"],
      "renderMode": "sanitize-generated-html",
      "allowedElements": [
        "a", "blockquote", "br", "caption", "code", "del", "div", "em",
        "figcaption", "figure", "h1", "h2", "h3", "h4", "h5", "h6",
        "hr", "img", "ins", "li", "mark", "ol", "p", "pre", "section",
        "span", "strong", "sub", "sup", "table", "tbody", "td", "tfoot",
        "th", "thead", "tr", "ul"
      ],
      "allowedAttributes": {
        "*": ["aria-*", "class", "id", "lang", "role", "title", "data-pdc-*", "data-x-*-*"],
        "a": ["href"],
        "img": ["alt", "height", "src", "width"],
        "ol": ["start", "type"],
        "td": ["colspan", "rowspan"],
        "th": ["colspan", "rowspan", "scope"]
      },
      "blockedAttributes": ["style", "srcdoc", "on*"],
      "blockedElements": [
        "applet", "audio", "base", "button", "embed", "form", "iframe",
        "input", "link", "meta", "object", "script", "select", "source",
        "style", "textarea", "track", "video"
      ],
      "unknownElementAction": "unwrap-preserving-children",
      "blockedElementAction": "remove-entire-subtree",
      "rawHtml": {
        "preserveSource": true,
        "renderMode": "forbidden-in-profile",
        "activeConstructsDiagnostic": "unsafe_content"
      }
    }
  }
}
