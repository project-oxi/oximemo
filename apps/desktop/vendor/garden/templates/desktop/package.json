{
  "name": "garden-desktop-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "vendor/garden/packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "sync": "node vendor/garden/cli/garden.mjs sync",
    "doctor": "node vendor/garden/cli/garden.mjs doctor",
    "test": "bun test vendor/garden/packages/markdown/tests vendor/garden/packages/editor/tests"
  },
  "dependencies": {
    "@garden/ui": "workspace:*",
    "@garden/editor": "workspace:*",
    "@garden/markdown": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tauri-apps/api": "2.12.0",
    "@garden/native": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@tailwindcss/vite": "4.1.18",
    "@vitejs/plugin-react": "4.7.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  },
  "packageManager": "bun@1.4.2"
}
