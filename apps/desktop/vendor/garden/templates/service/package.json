{
  "name": "garden-service-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "vendor/garden/packages/*"
  ],
  "scripts": {
    "sync": "node vendor/garden/cli/garden.mjs sync",
    "build": "tsc --noEmit -p tsconfig.json",
    "start": "bun run src/index.ts",
    "doctor": "node vendor/garden/cli/garden.mjs doctor",
    "test": "bun test vendor/garden/packages/daemon-kit/tests"
  },
  "dependencies": {
    "@garden/daemon-kit": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "5.9.3"
  }
}
